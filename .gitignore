# Source distribution: only the desktop app and its build inputs.
/*
!/.gitignore
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/postcss.config.js
!/tailwind.config.js
!/tsconfig.json
!/vite.config.ts
!/src/
!/src-tauri/

/src-tauri/*
!/src-tauri/Cargo.toml
!/src-tauri/Cargo.lock
!/src-tauri/build.rs
!/src-tauri/tauri.conf.json
!/src-tauri/capabilities/
!/src-tauri/icons/
!/src-tauri/src/

# Generated files, tests, local configuration, and signing material.
node_modules/
dist/
target/
gen/
tests/
__tests__/
*.test.*
*.spec.*
*.fixture.*
.env
.env.*
.publisher/
.local-publisher/
*.log
*.exe
*.dll
*.pdb
*.tsbuildinfo
